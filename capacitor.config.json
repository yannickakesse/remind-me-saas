{
  "appId": "com.tryremindme.app",
  "appName": "Remind Me",
  "webDir": "mobile/www",
  "backgroundColor": "#0B0F17",
  "appendUserAgent": "RemindMeApp",
  "server": {
    "url": "https://tryremind-me.vercel.app/login",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0B0F17",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0F17",
      "overlaysWebView": false
    }
  }
}
